{
  "name": "jev-mcp",
  "version": "0.13.0",
  "description": "MCP server exposing TypeSafe Jev typed judgments: classify, score, check, a batched multi-question ask, a many-item triage with server-side file reads, and model discovery.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxkimambo/jev-mcp.git"
  },
  "homepage": "https://github.com/maxkimambo/jev-mcp#readme",
  "bugs": {
    "url": "https://github.com/maxkimambo/jev-mcp/issues"
  },
  "bin": {
    "jev-mcp": "bundle/index.js"
  },
  "files": [
    "bundle",
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "typesafe",
    "jev",
    "system-one",
    "classification",
    "confidence",
    "ai"
  ],
  "scripts": {
    "build": "tsc && npm run bundle",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "start": "node bundle/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node --test test/e2e.test.mjs",
    "bundle": "esbuild src/index.ts src/cli.ts --bundle --platform=node --format=esm --target=node20 --outdir=bundle --log-level=warning --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
