{
  "name": "jev",
  "displayName": "TypeSafe Jev",
  "description": "Let TypeSafe Jev read files, logs and search results so the agent reads only the answer: search, locate, extract, screen, ask and triage, plus classify, score and check. Off by default; /jev on.",
  "version": "0.13.0",
  "author": {
    "name": "Max Kimambo",
    "url": "https://github.com/maxkimambo"
  },
  "homepage": "https://github.com/maxkimambo/jev-mcp",
  "repository": "https://github.com/maxkimambo/jev-mcp",
  "license": "MIT",
  "keywords": [
    "mcp",
    "typesafe",
    "jev",
    "system-one",
    "classification",
    "confidence"
  ],
  "skills": "./skills/",
  "mcpServers": {
    "jev": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bundle/index.js"
      ],
      "env": {
        "JEV_SWITCH_FILE": "${HOME}/.claude/jev-think/state.json",
        "JEV_LEDGER": "${HOME}/.claude/jev-think/ledger.jsonl"
      }
    }
  }
}
